{
  "name": "tournament-clock",
  "productName": "Tournament Clock",
  "version": "1.0.0",
  "description": "A poker tournament blind clock",
  "author": "MrAnderson616",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mranderson616.tournamentclock",
    "productName": "Tournament Clock",
    "copyright": "Copyright \u00a9 2026 MrAnderson616",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "renderer/**/*"
    ],
    "artifactName": "TournamentClock-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Tournament Clock ${version} ${arch}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Tournament Clock"
    },
    "portable": {
      "artifactName": "TournamentClock-${version}-portable.${ext}"
    },
    "afterPack": "build/after-pack.js"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
